{
  "name": "potree",
  "private": true,
  "version": "1.8.0",
  "description": "WebGL2 point cloud viewer. Modernized",
  "keywords": [
    "point",
    "cloud",
    "pointcloud",
    "octree",
    "entwine",
    "viewer",
    "threejs",
    "webgl",
    "browser",
    "tool"
  ],
  "main": "./example/index.js",
  "scripts": {
    "start_old": "gulp watch",
    "build_old": "gulp build pack",
    "build_bad": "webpack --mode production",


    "build": "npm run build:module",
    "build:workers": "vite build --config vite.workers.config.mjs",
    "build:module": "npm run build:workers && vite build",
    "start": "npm run build:module && npm run dev",
  	"dev": "vite --port 5200 --open",
    "check:imports": "node scripts/check-missing-imports.mjs --scope src --allow Potree,viewer",
    "check:imports:all": "node scripts/check-missing-imports.mjs --scope all --allow Potree,viewer",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@tweenjs/tween.js": "^25.0.0",
    "copc": "^0.0.7",
    "copy-webpack-plugin": "^13.0.1",
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-connect": "^5.7.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.4",
    "i18next": "^25.5.2",
    "interactjs": "^1.10.27",
    "json5": "^2.1.3",
    "proj4": "^2.19.10",
    "rollup": "^3.29.4",
    "s-": "^0.0.1",
    "three": "^0.182.0",
    "through": "~2.3.4",
    "ts-loader": "^9.5.4",
    "uglify-js": "^3.19.3",
    "uuid": "^13.0.0"
  },
  "author": "Markus Schütz",
  "license": "BSD-2-CLAUSE",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "vite": "^5.4.19",
    "vite-plugin-static-copy": "^1.0.6",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^4.15.1"
  }
}
