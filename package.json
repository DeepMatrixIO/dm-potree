{
  "name": "potree",
  "private": true,
  "version": "1.8.0",
  "description": "WebGL point cloud viewer",
  "keywords": [
    "point",
    "cloud",
    "pointcloud",
    "octree",
    "entwine",
    "viewer",
    "threejs",
    "webgl",
    "browser",
    "tool"
  ],
  "main": "./build/potree/potree.js",
  "type": "module",
  "scripts": {
    "start": "gulp watch",
    "build": "gulp --gulpfile gulpfile.cjs build pack",
    "postinstall": "npm run build",
    "build_module": "webpack --mode production --config webpack.prod.js",
    "start_module": "webpack-dev-server --config webpack.example.js --mode development --progress --port 5200"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "copy-webpack-plugin": "11.0.0",
    "html-webpack-plugin": "5.5.0",
    "ts-loader": "9.5.1",
    "typescript": "5.5.4",
    "webpack": "5.94.0",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.0.4"
  },
  "dependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "copc": "^0.0.7",
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-connect": "^5.7.0",
    "jquery": "^3.7.1",
    "json5": "^2.1.3",
    "proj4": "^2.15.0",
    "rollup": "^3.29.4",
    "three": "^0.172.0",
    "through": "~2.3.4"
  },
  "author": "Markus Schütz",
  "license": "BSD-2-CLAUSE"
}
